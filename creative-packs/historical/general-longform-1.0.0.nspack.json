    ],
    "integrity": {
      "algorithm": "sha256",
      "sha256": "46c63153cead13179fc7789a137d6e1262d904fda5f8a91774adf7fcb5ac255a"
    }
  },
  "prompts": {
    "planning_field": {
      "name": "专项故事规划",
      "version": 1,
      "system": "先确定当前字段在长篇因果链中的职责，再给出可以直接影响人物行动、选择和后果的具体候选。",
      "request": "根据字段定义、相邻已确认字段和创作边界生成当前字段；不重复已有内容，不以抽象宣传语代替可执行设计。"
    },
    "chapter_card": {
      "name": "可执行章节合同",
      "version": 1,
      "system": "章节卡是一份可验证的叙事合同，每个结果都应由人物行动或新信息触发。",
      "request": "承接上一章状态，给出主角本章可执行目标、具体阻力、行动触发的转折、明确回报与代价、章尾边界，以及 1 至 6 个必要场景。"
    },
    "scene_plan": {
      "name": "连续状态场景卡",
      "version": 1,
      "system": "每个场景都必须从明确进入状态，经由目标、阻力和行动发生变化，并以可供下一场直接承接的退出状态结束。",
      "request": "把已确认章节合同拆成结构化场景；保持视角、时间、地点、在场人物、人物知情范围、伤情、持有物和世界硬规则连续。"
    },
    "chapter": {
      "name": "章节正文候选",
      "version": 1,
      "system": "正文通过人物选择和可感知证据推进，不用解释替代场景，不把章节合同之外的事件提前写入。",
      "request": "严格沿场景计划完成本章正文，让每场至少改变局面、关系、信息或风险之一；停在章节卡约定的最后事件。"
    },
    "rewrite": {
      "name": "受约束局部重写",
      "version": 1,
      "system": "只改变用户指定范围及其表达功能，保留未涉及的事实、事件顺序、人物状态与章尾合同。",
      "request": "按本次重写目标生成可比较候选。"
    },
    "chapter_state_extract": {
      "name": "章后状态候选",
      "version": 1,
      "system": "只从已接受正文提取可举证事实、人物状态、时间线、伏笔和未决线程，不把推测升级为事实。",
      "request": "生成可供下一章继承并由作者确认的章后状态候选。"
    },
    "continuity_audit": {
      "name": "跨章连续性审计",
      "version": 1,
      "system": "只报告能够同时给出两侧来源证据的冲突；证据不足的项目放入 uncertain。",
      "request": "检查人物状态、知情范围、时间线、持有物、世界规则和章节边界。"
    },
    "quality_review": {
      "name": "独立创作质量评审",
      "version": 1,
      "system": "使用固定七维标准审阅候选，问题必须包含证据、严重度、违反标准和最小修复指令。",
      "request": "分别评价规划遵循、因果推进、场景变化、连续性、人物主动性与声音、悬念与结尾、文字自然度。"
    }
  },
  "schemas": {
