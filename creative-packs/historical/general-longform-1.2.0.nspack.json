  "prompts": {
    "planning_field": {
      "name": "专项故事规划",
      "version": 1,
      "system": "先确定当前字段在长篇因果链中的职责，再给出可以直接影响人物行动、选择和后果的具体候选。",
      "request": "根据字段定义、相邻已确认字段和创作边界生成当前字段；不重复已有内容，不以抽象宣传语代替可执行设计。"
    },
    "story_change": {
      "name": "全书设定联动修改",
      "version": 1,
      "system": "把根设定变化视为一次受约束的全书一致性迁移。只引用输入目录中存在的 targetKey；先判断事实依赖、因果依赖、人物知情边界、世界硬规则、时间线和已写正文，再给出最小而完整的同步修改。不得为了省事重写无关内容，不得把未确认候选当成事实。",
      "request": "根据根设定、作者修改意图、确定性命中项和项目字段目录，返回一个变更集。根设定必须出现；required 表示不改就会直接矛盾，suggested 表示为维持因果或表达一致建议同步，review 表示尤其是既有正文需要作者逐项审阅。after 必须是该目标字段的完整替换值。"
    },
    "chapter_card": {
      "name": "可执行章节合同",
      "version": 1,
      "system": "章节卡是一份可验证的叙事合同，每个结果都应由人物行动或新信息触发。",
      "request": "承接上一章状态，给出主角本章可执行目标、具体阻力、行动触发的转折、明确回报与代价、章尾边界，以及 1 至 6 个必要场景。"
    },
    "scene_plan": {
      "name": "连续状态场景卡",
      "version": 1,
      "system": "每个场景都必须从明确进入状态，经由目标、阻力和行动发生变化，并以可供下一场直接承接的退出状态结束。",
      "request": "把已确认章节合同拆成结构化场景；保持视角、时间、地点、在场人物、人物知情范围、伤情、持有物和世界硬规则连续。"
    },
    "chapter": {
      "name": "章节正文候选",
      "version": 2,
      "system": "正文通过人物选择和可感知证据推进，不用解释替代场景，不把章节合同之外的事件提前写入。同一时刻、主体、动作链或因果中的信息优先组成连续句群；短句只有在注意力转移、人物决定、不可逆变化或对白落点时才单独成立。",
      "request": "严格沿场景计划完成本章正文，让每场至少改变局面、关系、信息或风险之一；停在章节卡约定的最后事件。返回前检查相邻句群：不要把一个完整交互拆成机械的‘动作。反应。作者判断。’，不要用省略动作对象制造虚假停顿，也不要在普通动作后追加抽象总结或反差金句。若连续三句都只是长度相近的单一动作、否定反应或作者判断，重组为动作—对象—结果或感知—判断—选择，但保留真正有节奏作用的短句。"
    },
    "rewrite": {
      "name": "受约束局部重写",
      "version": 2,
      "system": "只改变用户指定范围及其表达功能，保留未涉及的事实、事件顺序、人物状态与章尾合同。真人化修改以句群为单位，不对整章做平均化同义改写。",
      "request": "按本次重写目标生成可比较候选。命中机械短句、孤立否定动作、动作对象缺失或抽象总结时，合并同一交互并补清对象、空间关系和结果；短句确实承担决定、转向或落点时保留。"
    },
    "chapter_state_extract": {
      "name": "章后状态候选",
      "version": 1,
      "system": "只从已接受正文提取可举证事实、人物状态、时间线、伏笔和未决线程，不把推测升级为事实。",
      "request": "生成可供下一章继承并由作者确认的章后状态候选。"
    },
    "continuity_audit": {
      "name": "跨章连续性审计",
      "version": 1,
      "system": "只报告能够同时给出两侧来源证据的冲突；证据不足的项目放入 uncertain。",
      "request": "检查人物状态、知情范围、时间线、持有物、世界规则和章节边界。"
    },
    "quality_review": {
      "name": "独立创作质量评审",
      "version": 2,
      "system": "使用固定七维标准审阅候选，问题必须包含成簇证据、严重度、违反标准和最小修复指令。单个短句不自动构成问题，只有同类结构反复出现并损害动作清晰度、人物声音或节奏时才扣分。",
      "request": "分别评价规划遵循、因果推进、场景变化、连续性、人物主动性与声音、悬念与结尾、文字自然度。自然度重点检查连续机械短句、动作—反应被句号硬切、孤立的‘人物没/不+动作’、动作对象省略、现场被抽象总结替代和每段都追求工整落点；修复指令必须指出要重组的句群、应补清的对象或应删除的总结，不得笼统要求增加长句。"
    }
  },
