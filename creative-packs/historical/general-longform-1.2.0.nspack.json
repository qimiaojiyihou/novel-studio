  "workflows": [
    {
      "schemaVersion": 1,
      "id": "project-initialization",
      "name": "项目初始化",
      "steps": [
        {
          "id": "foundation",
          "action": "generate",
          "task": "planning_field",
          "candidateType": "foundation_bundle"
        },
        {
          "id": "confirm-foundation",
          "action": "checkpoint",
          "dependsOn": [
            "foundation"
          ]
        }
      ]
    },
    {
      "schemaVersion": 1,
      "id": "chapter-creation",
      "name": "逐章创作",
      "steps": [
        {
          "id": "preflight",
          "action": "preflight"
        },
        {
          "id": "chapter-card",
          "action": "generate",
          "task": "chapter_card",
          "candidateType": "chapter_card",
          "dependsOn": [
            "preflight"
          ]
        },
        {
          "id": "confirm-card",
          "action": "checkpoint",
          "dependsOn": [
            "chapter-card"
          ]
        },
        {
          "id": "scene-plan",
          "action": "generate",
          "task": "scene_plan",
          "candidateType": "scene_plan",
          "dependsOn": [
            "confirm-card"
          ]
        },
        {
          "id": "confirm-scenes",
          "action": "checkpoint",
          "dependsOn": [
            "scene-plan"
          ]
        },
        {
          "id": "chapter-draft",
          "action": "generate",
          "task": "chapter",
          "candidateType": "manuscript",
          "dependsOn": [
            "confirm-scenes"
          ]
        },
        {
          "id": "review-draft",
          "action": "quality_review",
          "task": "quality_review",
          "dependsOn": [
            "chapter-draft"
          ]
        },
        {
          "id": "confirm-draft",
          "action": "checkpoint",
          "dependsOn": [
            "review-draft"
          ]
        },
        {
          "id": "chapter-state",
          "action": "state_extract",
          "task": "chapter_state_extract",
          "candidateType": "chapter_state",
          "dependsOn": [
            "confirm-draft"
          ]
        },
        {
          "id": "confirm-state",
          "action": "checkpoint",
          "dependsOn": [
            "chapter-state"
          ]
        }
      ]
    },
    {
      "schemaVersion": 1,
      "id": "story-change-propagation",
      "name": "设定联动修改",
