{
  "creativePack": {
    "id": "official.general-longform.zh-CN",
    "version": "1.1.0",
    "digest": "c00b4a6998ed9b39653aa76d3adfe8d78d3977d198453f2a264809d982af2d90"
  },
  "schemas": {
    "foundationBundle": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "foundation",
        "mainCharacter",
        "world",
        "outline"
      ],
      "properties": {
        "foundation": {
          "type": "object",
          "required": [
            "premise",
            "storyPromise",
            "coreConflict"
          ],
          "properties": {
            "premise": {
              "type": "string",
              "minLength": 1
            },
            "storyPromise": {
              "type": "string",
              "minLength": 1
            },
            "coreConflict": {
              "type": "string",
              "minLength": 1
            },
            "audience": {
              "type": "string"
            },
            "lengthTarget": {
              "type": "string"
            },
            "themes": {
              "type": "string"
            },
            "tone": {
              "type": "string"
            },
            "endingDirection": {
              "type": "string"
            },
            "boundaries": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "mainCharacter": {
          "type": "object",
          "required": [
            "title",
            "role",
            "identity",
            "desire",
            "need",
            "fear"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "desire": {
              "type": "string",
              "minLength": 1
            },
            "need": {
              "type": "string",
              "minLength": 1
            },
            "fear": {
              "type": "string",
              "minLength": 1
            },
            "flaw": {
              "type": "string"
            },
            "secret": {
              "type": "string"
            },
            "arc": {
              "type": "string"
            },
            "voice": {
              "type": "string"
            },
            "relationships": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "world": {
          "type": "object",
          "required": [
            "hardRules",
            "costs"
          ],
          "properties": {
            "era": {
              "type": "string"
            },
            "geography": {
              "type": "string"
            },
            "society": {
              "type": "string"
            },
            "powerSystem": {
              "type": "string"
            },
            "hardRules": {
              "type": "string",
              "minLength": 1
            },
            "costs": {
              "type": "string",
              "minLength": 1
            },
            "dailyLife": {
              "type": "string"
            },
            "history": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "outline": {
          "type": "object",
          "required": [
            "logline",
            "opening",
            "incitingIncident",
            "climax",
            "ending"
          ],
          "properties": {
            "logline": {
              "type": "string",
              "minLength": 1
            },
            "opening": {
              "type": "string",
              "minLength": 1
            },
            "incitingIncident": {
              "type": "string",
              "minLength": 1
            },
            "firstTurn": {
              "type": "string"
            },
            "midpoint": {
              "type": "string"
            },
            "secondTurn": {
              "type": "string"
            },
            "climax": {
              "type": "string",
              "minLength": 1
            },
            "ending": {
              "type": "string",
              "minLength": 1
            },
            "thematicArc": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "storyChange": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "StoryChangeSetCandidate",
      "type": "object",
      "required": [
        "summary",
        "items"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "targetKey",
              "after",
              "impactLevel",
              "reason",
              "evidence",
              "selected"
            ],
            "properties": {
              "targetKey": {
                "type": "string",
                "minLength": 3
              },
              "after": {},
              "impactLevel": {
                "type": "string",
                "enum": [
                  "required",
                  "suggested",
                  "review"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "selected": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "chapterCard": {
      "$id": "novel-studio://schemas/chapter-card@1",
      "type": "object",
      "required": [
        "goal",
        "protagonistGoal",
        "resistance",
        "turningPoint",
        "payoff",
        "cost",
        "ending",
        "requiredScenes"
      ]
    },
    "scenePlan": {
      "$id": "novel-studio://schemas/scene-plan@1",
      "type": "object",
      "required": [
        "schemaVersion",
        "summary",
        "scenes",
        "legacyNotes"
      ]
    },
    "chapterState": {
      "$id": "novel-studio://schemas/chapter-state@1",
      "type": "object",
      "required": [
        "summary",
        "facts",
        "characterStates",
        "relationshipChanges",
        "timelineEvents",
        "foreshadow",
        "openThreads"
      ]
    },
    "qualityReview": {
      "$id": "novel-studio://schemas/quality-review@1",
      "type": "object",
      "required": [
        "scores",
        "issues",
        "summary"
      ]
    }
  },
  "workflows": [
    {
      "schemaVersion": 1,
      "id": "project-initialization",
      "name": "项目初始化",
      "steps": [
        {
          "id": "foundation",
          "action": "generate",
          "task": "planning_field",
          "candidateType": "foundation_bundle"
        },
        {
          "id": "confirm-foundation",
          "action": "checkpoint",
          "dependsOn": [
            "foundation"
          ]
        }
      ]
    },
    {
      "schemaVersion": 1,
      "id": "chapter-creation",
      "name": "逐章创作",
      "steps": [
        {
          "id": "preflight",
          "action": "preflight"
        },
        {
          "id": "chapter-card",
          "action": "generate",
          "task": "chapter_card",
          "candidateType": "chapter_card",
          "dependsOn": [
            "preflight"
          ]
        },
        {
          "id": "confirm-card",
          "action": "checkpoint",
          "dependsOn": [
            "chapter-card"
          ]
        },
        {
          "id": "scene-plan",
          "action": "generate",
          "task": "scene_plan",
          "candidateType": "scene_plan",
          "dependsOn": [
            "confirm-card"
          ]
        },
        {
          "id": "confirm-scenes",
          "action": "checkpoint",
          "dependsOn": [
            "scene-plan"
          ]
        },
        {
          "id": "chapter-draft",
          "action": "generate",
          "task": "chapter",
          "candidateType": "manuscript",
          "dependsOn": [
            "confirm-scenes"
          ]
        },
        {
          "id": "review-draft",
          "action": "quality_review",
          "task": "quality_review",
          "dependsOn": [
            "chapter-draft"
          ]
        },
        {
          "id": "confirm-draft",
          "action": "checkpoint",
          "dependsOn": [
            "review-draft"
          ]
        },
        {
          "id": "chapter-state",
          "action": "state_extract",
          "task": "chapter_state_extract",
          "candidateType": "chapter_state",
          "dependsOn": [
            "confirm-draft"
          ]
        },
        {
          "id": "confirm-state",
          "action": "checkpoint",
          "dependsOn": [
            "chapter-state"
          ]
        }
      ]
    },
    {
      "schemaVersion": 1,
      "id": "story-change-propagation",
      "name": "设定联动修改",
      "steps": [
        {
          "id": "analyze-change",
          "action": "generate",
          "task": "story_change",
          "candidateType": "story_change_set"
        },
        {
          "id": "confirm-change-set",
          "action": "checkpoint",
          "dependsOn": [
            "analyze-change"
          ]
        }
      ]
    }
  ]
}
